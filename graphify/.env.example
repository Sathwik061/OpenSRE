# ── Camunda Version & Endpoints ───────────────────────────────────────────────
# Default runtime target: 8.9 (or set to 8.6, 8.7, 8.8, 8.10)
CAMUNDA_VERSION=8.9
CAMUNDA_URL=http://localhost:8080/engine-rest

# ── Sentinel ──────────────────────────────────────────────────────────────────
SENTINEL_URL=http://localhost:5000

# ── OpenSRE (already configured via opensre onboarding) ──────────────────────
# The opensre CLI reads its own config from %APPDATA%\opensre or ~/.opensre
# No extra env vars needed here unless you want to override the model.

# ── Future: Slack / PagerDuty notifications ───────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PAGERDUTY_ROUTING_KEY=...
